PORT=""

DB_HOST=""
DB_USER=""   
DB_PASSWORD=""
DB_NAME=""
DB_PORT=""
JWT_SECRET=""
JWT_EXPIRES_IN=""

# ==========================================================
# KHÓA CỨNG: CHỈ MÁY CỦA TÔI & ĐÚNG IP CHỖ ĐANG NGỒI
# ==========================================================
STRICT_ATTENDANCE_LOCK=
ALLOWED_ATTENDANCE_IPS=127.0.0.1,::1,172.21.64.1,10.24.9.230,118.70.126.55
# Chỉ cấu hình khi chạy sau reverse proxy. Ví dụ: 1 (một hop), true, hoặc subnet.
TRUST_PROXY=
# Để trống để kiosk tự tạo mã thiết bị và bỏ qua bước khóa máy. Khi đã có UUID của kiosk, dán vào đây để chỉ cho máy đó điểm danh.
ALLOWED_DEVICE_ID=

# ==========================================================
# FACEID: NGƯỠNG SO KHỚP ( cosine, càng cao càng giống )
# ==========================================================
# Chỉ dùng cho điểm danh. Giữ nguyên 0.76 để không thay đổi luồng chấm công.
ATTENDANCE_MATCH_THRESHOLD=0.76
# Dùng riêng để chặn trùng khi kích hoạt. Thấp hơn ngưỡng điểm danh để bắt cả ca cười/đổi sắc mặt.
DUPLICATE_FACE_THRESHOLD=0.7
