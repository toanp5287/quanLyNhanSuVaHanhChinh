PORT=""

DB_HOST=""
DB_USER=""   
DB_PASSWORD=""
DB_NAME=""
DB_PORT=""
JWT_SECRET=""
JWT_EXPIRES_IN=""

# ==========================================================
# KHÓA CỨNG: CHỈ MÁY CỦA TÔI & ĐÚNG IP CHỖ ĐANG NGỒI
# ==========================================================
STRICT_ATTENDANCE_LOCK=
ALLOWED_ATTENDANCE_IPS=127.0.0.1,::1,172.21.64.1,10.24.9.230,118.70.126.55
# Chỉ cấu hình khi chạy sau reverse proxy. Ví dụ: 1 (một hop), true, hoặc subnet.
TRUST_PROXY=
# Để trống để kiosk tự tạo mã thiết bị và bỏ qua bước khóa máy. Khi đã có UUID của kiosk, dán vào đây để chỉ cho máy đó điểm danh.
ALLOWED_DEVICE_ID=

# ==========================================================
# ONLYOFFICE DOCUMENT SERVER - XEM/CHỈNH SỬA HỢP ĐỒNG DOCX
# ==========================================================
ONLYOFFICE_URL=http://localhost:8081
ONLYOFFICE_JWT_SECRET=
# URL backend mà Document Server có thể gọi lại (không dùng localhost nếu chạy Docker)
CONTRACT_API_BASE_URL=http://localhost:8080
# Các role được xem hợp đồng đã duyệt ở quyền người ký
CONTRACT_SIGNER_ROLES=CB_PAYROLL,OFFICE_ADMIN,SUPER_ADMIN
